# =============================================================================
# AI Research Landscape Agent — environment
# Copy to .env and fill in. Everything has a working default except the API key.
# =============================================================================

# --- LLM ---------------------------------------------------------------------
# Which backend serves rerank-judging, extraction, and synthesis.
#   nim        -> NVIDIA NIM (default), uses extra_body.nvext.guided_json
#   openrouter -> OpenRouter, uses response_format json_schema + require_parameters
LLM_PROVIDER=nim

NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Do not guess this slug. Confirm it against the live list first:
#   curl -s "$NVIDIA_BASE_URL/models" -H "Authorization: Bearer $NVIDIA_API_KEY"
#   curl -s "https://openrouter.ai/api/v1/models"
# Two things verified live on NIM (2026-09), worth knowing before you pick:
#   * meta/llama-3.1-70b-instruct is NOT in the catalogue, despite being the
#     slug most tutorials use. The nemotron tune is:
#     nvidia/llama-3.1-nemotron-70b-instruct -- but some catalogue slugs 404 at
#     call time anyway ("Function ... Not found for account"), so run one real
#     completion after choosing.
#   * meta/llama-3.2-11b-vision-instruct was verified end-to-end: 200 on
#     chat/completions and it honours nvext.guided_json. It also tends to nest
#     its JSON under a "fields" key, which the client unwraps.
LLM_MODEL=meta/llama-3.2-11b-vision-instruct

LLM_CONCURRENCY=4
LLM_MAX_REPAIRS=2
LLM_TIMEOUT_SECONDS=120

# --- Retrieval (arXiv) -------------------------------------------------------
# arXiv asks for no more than one request every 3 seconds, single connection.
# Do not lower this.
ARXIV_DELAY_SECONDS=3.0
ARXIV_NUM_RETRIES=5
ARXIV_PAGE_SIZE=100
RETRIEVAL_MAX_RESULTS=200
RETRIEVAL_CACHE_TTL_HOURS=24
RETRIEVAL_CACHE_DIR=./data/cache/arxiv

# Test hooks — leave unset in normal use.
# ARXIV_OFFLINE=1     # never touch the network; cache/fixtures only
# ARXIV_FORCE_429=1   # simulate arXiv throttling

# --- Reranking ---------------------------------------------------------------
# Cross-encoder scores every candidate; the LLM judge scores the top seed set.
# The blend weights must sum to 1.0.
RERANK_SEED_COUNT=40
RERANK_FINAL_COUNT=60
RERANK_BLEND_CE=0.6
RERANK_BLEND_LLM=0.4
RERANK_JUDGE_BATCH_SIZE=10

CROSS_ENCODER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
CROSS_ENCODER_DEVICE=cpu
# 512, not 256: abstracts run 1200-1800 chars (~300-450 tokens) and 256 silently
# truncates the tail, which is where the contribution and results usually live.
CROSS_ENCODER_MAX_LENGTH=512
CROSS_ENCODER_BATCH_SIZE=16

# --- Embeddings and layout ---------------------------------------------------
EMBED_MODEL=BAAI/bge-base-en-v1.5
UMAP_RANDOM_STATE=42
UMAP_N_NEIGHBORS=15
UMAP_MIN_DIST=0.1
# 0 means auto: max(3, paper_count // 12)
HDBSCAN_MIN_CLUSTER_SIZE=0

# --- Storage -----------------------------------------------------------------
DB_PATH=./data/landscapes.db
# Bump when the extraction prompt or schema changes; invalidates the
# (paper_id, prompt_version) extraction cache without touching embeddings.
PROMPT_VERSION=extract_v1

# --- Server ------------------------------------------------------------------
API_PORT=8000
ALLOWED_ORIGINS=http://localhost:3000
LOG_LEVEL=INFO
